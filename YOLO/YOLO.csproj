<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Library</OutputType>
    <UseMaui>false</UseMaui>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Astator" Version="1.2.0" />
    <PackageReference Include="YoloDotNet" Version="4.2.0" />
    <PackageReference Include="YoloDotNet.ExecutionProvider.Cpu" Version="1.1.0" />
  </ItemGroup>
  <ProjectExtensions>
    <Label>YOLO</Label>
    <PackageName>com.script.YOLO</PackageName>
    <Author>unknown</Author>
    <Version>1.0.0</Version>
    <Description>在这里填写关于脚本的描述</Description>
    <IncludeArm64>true</IncludeArm64>
    <IncludeX64>true</IncludeX64>
    <IncludeOnnx>true</IncludeOnnx>
    <Obfuscator>
      <IsObfuscate>true</IsObfuscate>
      <RenameProperties>true</RenameProperties>
      <RenameEvents>true</RenameEvents>
      <RenameFields>true</RenameFields>
      <KeepPublicApi>true</KeepPublicApi>
      <HidePrivateApi>true</HidePrivateApi>
      <ReuseNames>true</ReuseNames>
      <UseUnicodeNames>true</UseUnicodeNames>
      <UseKoreanNames>false</UseKoreanNames>
      <HideStrings>false</HideStrings>
    </Obfuscator>
  </ProjectExtensions>
</Project>
